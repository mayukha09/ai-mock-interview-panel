{
  "name": "ai-mock-interview-panel",
  "version": "1.0.0",
  "description": "AI-powered adaptive mock interview platform with Lyzr Agent integration",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types server/index.ts",
    "dev": "node --experimental-strip-types --watch server/index.ts",
    "build": "tsc",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "test": "node --experimental-strip-types test-api.ts"
  },
  "keywords": [
    "ai",
    "interview",
    "lyzr",
    "mock-interview",
    "adaptive-learning",
    "hackathon"
  ],
  "author": "Hackathon Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.7.0"
  }
}
